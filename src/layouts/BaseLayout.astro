---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'x1ngg3 的博客',
  description = '技术分享与生活碎碎念'
} = Astro.props;

const currentPath = Astro.url.pathname;
const navigation = [
  { href: '/', label: '首页', icon: 'home' },
  { href: '/posts', label: '文章', icon: 'writing' },
  { href: '/thoughts', label: '说说', icon: 'chat' },
  { href: '/about', label: '关于', icon: 'coffee' },
] as const;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="generator" content={Astro.generator}>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    {Astro.slots.has('cover') && <link rel="preload" as="image" type="image/webp" href="/images/DJI_20240916081052_0037_D.webp" />}
  </head>
  <body id="page-top">
    <a class="skip-link" href="#main-content">跳到正文</a>
    <slot name="cover" />

    <header class="nav">
      <div class="wrap nav-inner">
        <a href="/" class="nav-logo" aria-label="x1ngg3 的博客首页"><img class="logo-mark" src="/images/avatar.webp" alt="" width="30" height="30" decoding="async" />x1ngg3</a>
        <nav class="nav-links" aria-label="主导航">
          {navigation.map(item => (
            <a href={item.href} class:list={["nav-link", { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="nav-icon"><Icon name={item.icon} size={17} /></span>{item.label}
            </a>
          ))}
        </nav>
        <a class="nav-github" href="https://github.com/x1ngg3" target="_blank" rel="noopener noreferrer"><Icon name="github" size={17} />GitHub ↗</a>
      </div>
    </header>

    <main class="main" id="main-content" tabindex="-1"><slot /></main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <p class="footer-motto">记录所学，也记录生活。</p>
        <nav class="footer-links" aria-label="页脚链接">
          <a href="/posts">文章归档</a>
          <span aria-hidden="true">·</span>
          <a href="/about">关于本站</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/x1ngg3" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </nav>
        <p class="footer-copyright">© {new Date().getFullYear()} x1ngg3 · Built with Astro</p>
      </div>
    </footer>
  </body>
</html>

<style>
  body { min-height: 100vh; display: flex; flex-direction: column; }
  .skip-link { position: fixed; z-index: 200; top: 12px; left: 12px; padding: 8px 16px; background: white; border-radius: 6px; transform: translateY(-160%); }
  .skip-link:focus { transform: translateY(0); }
  .nav { position: sticky; top: 0; z-index: 100; flex-shrink: 0; background: rgb(255 255 255 / 95%); backdrop-filter: blur(16px); box-shadow: 0 1px 8px rgb(35 55 75 / 5%); }
  .nav-inner { min-height: var(--nav-height); display: flex; align-items: center; gap: 40px; }
  .nav-logo { display: flex; align-items: center; gap: 10px; font-size: 1.08rem; font-weight: 650; color: var(--color-ink); white-space: nowrap; }
  .logo-mark { display: block; flex-shrink: 0; width: 30px; height: 30px; object-fit: cover; border-radius: 8px; background: var(--color-accent-wash); }
  .nav-links { display: flex; align-items: center; align-self: stretch; gap: 8px; }
  .nav-link { display: flex; align-items: center; gap: 7px; position: relative; padding: 0 14px; color: var(--color-ink-soft); font-size: 0.9rem; font-weight: 500; }
  .nav-icon { color: currentColor; opacity: 0.8; }
  .nav-link:hover, .nav-link.is-active { color: var(--color-accent-deep); background: #f5f9f8; }
  .nav-link.is-active::after { content: ""; position: absolute; bottom: 0; left: 14px; right: 14px; height: 3px; border-radius: 3px 3px 0 0; background: var(--color-accent); }
  .nav-github { display: flex; align-items: center; gap: 8px; margin-left: auto; font-size: 0.8rem; color: var(--color-ink-mute); }
  .main { flex: 1; width: 100%; }
  .footer { padding: 40px 0 36px; color: var(--color-ink-mute); text-align: center; }
  .footer-motto { font-size: 0.9rem; margin-bottom: 8px; }
  .footer-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; font-size: 0.8rem; }
  .footer-copyright { margin-top: 8px; font-size: 0.75rem; }
  @media (max-width: 600px) {
    .nav-inner { gap: 12px; }
    .nav-logo { font-size: 1rem; gap: 7px; }
    .nav-links { gap: 0; margin-left: auto; }
    .nav-link { padding: 0 9px; font-size: 0.82rem; }
    .nav-icon, .nav-github { display: none; }
    .nav-link.is-active::after { left: 9px; right: 9px; }
  }
</style>
