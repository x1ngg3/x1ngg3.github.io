---
import ContentLayout from '../../layouts/ContentLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const allThoughts = (await getCollection('thoughts'))
  .sort((first, second) => second.data.date.getTime() - first.data.date.getTime());
const thoughtsWithContent = await Promise.all(allThoughts.map(async thought => {
  const { Content } = await thought.render();
  return { thought, Content };
}));
const monthKey = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' });
const months = [...new Set(allThoughts.map(thought => monthKey(thought.data.date)))];
const formatDay = (date: Date) => date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
const formatTime = (date: Date) => date.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', hour12: false });
---

<ContentLayout title="说说 · x1ngg3" description="日常里的片刻想法">
  <header class="page-head page-heading surface">
    <p class="eyebrow"><Icon name="chat" size={17} />日常的切片</p>
    <h1 class="page-title">说说</h1>
    <p class="page-lede">不必成篇，也值得记下。已经留下了 {allThoughts.length} 条碎碎念。</p>
  </header>

  <div class="log">
    {months.map(month => (
      <section class="month-block">
        <h2 class="month-label">{month}</h2>
        <ol class="entries">
          {thoughtsWithContent.filter(({ thought }) => monthKey(thought.data.date) === month).map(({ thought, Content }) => (
            <li class="entry surface" id={`note-${thought.slug}`}>
              <header class="entry-meta">
                <img class="entry-avatar" src="/images/avatar.webp" alt="" width="40" height="40" loading="lazy" decoding="async" />
                <div><span class="entry-author">x1ngg3</span><a href={`#note-${thought.slug}`} class="entry-permalink" aria-label={`${formatDay(thought.data.date)} 说说的永久链接`}><time datetime={thought.data.date.toISOString()}>{formatDay(thought.data.date)} · {formatTime(thought.data.date)}</time></a></div>
                {thought.data.mood && <span class="entry-mood">{thought.data.mood}</span>}
                <a href={`#note-${thought.slug}`} class="entry-anchor" aria-label="此条说说的链接">#</a>
              </header>
              <div class="entry-content"><Content /></div>
              {thought.data.tags && <div class="entry-tags">{thought.data.tags.map(tag => <span class="tag">{tag}</span>)}</div>}
            </li>
          ))}
        </ol>
      </section>
    ))}
    {allThoughts.length === 0 && <p class="empty surface">还没有说说，过段时间再来看看吧。</p>}
  </div>
</ContentLayout>

<style>
  .log { display: grid; gap: 28px; margin-top: 26px; }
  .month-label { font-size: 1rem; margin: 0 8px 16px; color: var(--color-ink-soft); }
  .entries { display: grid; gap: 20px; list-style: none; padding: 0; margin: 0; }
  .entry { padding: 28px var(--card-padding); margin: 0; border: 1px solid transparent; }
  .entry:target { border-color: var(--color-accent); }
  .entry-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; }
  .entry-avatar { display: block; flex-shrink: 0; width: 40px; height: 40px; object-fit: cover; border-radius: 50%; background: var(--color-accent-wash); }
  .entry-author { display: block; font-size: 0.86rem; font-weight: 600; line-height: 1.5; }
  .entry-permalink { display: block; color: var(--color-ink-mute); font-size: 0.75rem; }
  .entry-mood { font-size: 1.2rem; }
  .entry-anchor { margin-left: auto; color: var(--color-ink-faint); padding: 4px 8px; }
  .entry-content { font-size: 0.96rem; line-height: 1.9; }
  .entry-content :global(h2), .entry-content :global(h3) { font-size: 1.15rem; margin: 20px 0 12px; }
  .entry-content :global(p) { margin: 12px 0; line-height: 1.9; }
  .entry-content :global(> :first-child) { margin-top: 0; }
  .entry-content :global(> :last-child) { margin-bottom: 0; }
  .entry-content :global(a) { color: var(--color-accent-deep); text-decoration: underline; text-underline-offset: 3px; }
  .entry-tags { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .empty { padding: 32px; color: var(--color-ink-mute); }
  @media (max-width: 600px) { .entry { padding: 24px; } }
</style>
