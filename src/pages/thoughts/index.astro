---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allThoughts = (await getCollection('thoughts'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const thoughtsWithContent = await Promise.all(
  allThoughts.map(async (thought) => {
    const { Content } = await thought.render();
    return { thought, Content };
  })
);

// 按月份分组
function monthKey(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
}

const groupedByMonth = thoughtsWithContent.reduce((acc, item) => {
  const key = monthKey(item.thought.data.date);
  if (!acc[key]) acc[key] = [];
  acc[key].push(item);
  return acc;
}, {} as Record<string, typeof thoughtsWithContent>);

const months = Object.keys(groupedByMonth);

const formatDay = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

const formatTime = (d: Date) =>
  d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
---

<BaseLayout title="Notes · x1ngg3" description="Short thoughts and field notes">
  <div class="wrap page">
    <!-- ========= 顶部 ========= -->
    <header class="page-head">
      <p class="eyebrow">
        <span class="eyebrow-dot"></span>
        Logbook
      </p>
      <h1 class="page-title">Field notes</h1>
      <p class="page-lede">
        Short, dated thoughts. Written in passing, kept for memory.<br/>
        {allThoughts.length} {allThoughts.length === 1 ? 'entry' : 'entries'} in the log.
      </p>
    </header>

    <!-- ========= 笔记主体 ========= -->
    {thoughtsWithContent.length > 0 ? (
      <div class="log">
        {months.map((month) => (
          <section class="month-block">
            <header class="month-head">
              <h2 class="month-label">{month}</h2>
              <span class="month-count">
                {groupedByMonth[month].length} {groupedByMonth[month].length === 1 ? 'entry' : 'entries'}
              </span>
            </header>

            <ol class="entries">
              {groupedByMonth[month].map(({ thought, Content }) => (
                <li class="entry">
                  <aside class="entry-meta">
                    <time class="entry-day" datetime={thought.data.date.toISOString()}>
                      {formatDay(thought.data.date)}
                    </time>
                    <span class="entry-time">{formatTime(thought.data.date)}</span>
                    {thought.data.mood && (
                      <span class="entry-mood" aria-label="mood">{thought.data.mood}</span>
                    )}
                  </aside>

                  <div class="entry-content">
                    <Content />
                    {thought.data.tags && thought.data.tags.length > 0 && (
                      <div class="entry-tags">
                        {thought.data.tags.map((tag: string) => (
                          <span class="tag">{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    ) : (
      <div class="empty">
        <p>The logbook is empty.</p>
        <p class="empty-hint">
          Add your first entry in <code>src/content/thoughts/</code>.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page {
    padding: 4rem 0 2rem;
    max-width: 1040px;
    margin: 0 auto;
  }

  /* ========= 顶部 ========= */
  .page-head {
    margin-bottom: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .page-head .eyebrow {
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--color-ink);
    margin: 0 0 1.5rem;
  }

  .page-lede {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 50ch;
    margin: 0;
  }

  /* ========= 月份分组 ========= */
  .log {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .month-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .month-label {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }

  .month-count {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-ink-mute);
    letter-spacing: 0.01em;
  }

  /* ========= 条目列表 ========= */
  .entries {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2rem;
    align-items: start;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-rule-soft);
  }

  .entry:last-child {
    border-bottom: 1px solid var(--color-rule-soft);
  }

  /* ========= 左侧元数据 ========= */
  .entry-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.1rem;
  }

  .entry-day {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: 0.005em;
  }

  .entry-time {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink-mute);
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }

  .entry-mood {
    margin-top: 0.3rem;
    font-size: 1rem;
  }

  /* ========= 右侧内容 ========= */
  .entry-content {
    font-family: var(--font-sans);
    color: var(--color-ink);
    font-size: 0.98rem;
    line-height: 1.7;
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-rule);
    transition: border-color var(--duration) var(--ease);
  }

  .entry:hover .entry-content {
    border-left-color: var(--color-accent);
  }

  .entry-content :global(p) {
    margin: 0.5rem 0;
  }

  .entry-content :global(p:first-child) {
    margin-top: 0;
  }

  .entry-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .entry-content :global(a) {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-rule);
    transition: color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .entry-content :global(a:hover) {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  /* ========= 空状态 ========= */
  .empty {
    text-align: center;
    padding: 5rem 2rem;
    color: var(--color-ink-mute);
  }

  .empty-hint {
    font-size: 0.85rem;
    color: var(--color-ink-faint);
    margin-top: 0.5rem;
  }

  .empty code {
    color: var(--color-accent);
    background: var(--color-bg-offset);
  }

  /* ========= 响应式 ========= */
  @media (max-width: 768px) {
    .page {
      padding: 2rem 0 1rem;
    }

    .page-head {
      margin-bottom: 2.5rem;
      padding-bottom: 2rem;
    }

    .page-title {
      font-size: 2.5rem;
    }

    .log {
      gap: 3rem;
    }

    .month-label {
      font-size: 1.3rem;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 1.25rem 0;
    }

    .entry-meta {
      flex-direction: row;
      align-items: baseline;
      gap: 0.85rem;
    }

    .entry-content {
      padding-left: 1rem;
    }
  }
</style>
