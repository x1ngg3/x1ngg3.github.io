---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  allPosts: CollectionEntry<'posts'>[];
}

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await post.render();

const tocHeadings = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const articleUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit', year: 'numeric' });

// 阅读时长估算
const wordCount = (post.body || '').replace(/\s+/g, '').length;
const readingMinutes = Math.max(1, Math.round(wordCount / 300));

const otherPosts = allPosts
  .filter(otherPost => !otherPost.data.draft && otherPost.slug !== post.slug)
  .sort((first, second) => second.data.date.getTime() - first.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout title={`${post.data.title} · x1ngg3`} description={post.data.description || ''}>
  <article class="article">
    <div class:list={["article-layout", { 'has-toc': tocHeadings.length > 0 }]}>
      <div class="article-content-wrap surface">
        <header class="article-header">
          <p class="article-eyebrow">
            <span class="eyebrow-dot"></span>
            {post.data.category}
          </p>
          <h1 class="article-title">{post.data.title}</h1>
          <div class="article-meta">
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <span class="meta-sep">·</span>
            <span>{post.data.author || 'x1ngg3'}</span>
            <span class="meta-sep">·</span>
            <span>约 {readingMinutes} 分钟</span>
          </div>
          {post.data.description && (
            <p class="article-lede">{post.data.description}</p>
          )}
        </header>

        <div class="article-content">
          <Content />
        </div>

        <footer class="article-footer">
          <div class="footer-actions">
            <a href="/posts" class="back-link">
              <span aria-hidden="true">←</span>
              <span>全部文章</span>
            </a>

            <div class="share">
              <button type="button" class="share-link copy-link" data-copy-url={articleUrl} hidden>复制链接</button>
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(articleUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-link"
                aria-label="Share on Twitter"
              >Twitter</a>
              <a
                href={`mailto:?subject=${encodeURIComponent(post.data.title)}&body=${encodeURIComponent(articleUrl)}`}
                class="share-link"
                aria-label="Share via email"
              >Email</a>
            </div>
          </div>
          <p class="share-status" role="status" aria-live="polite"></p>
        </footer>

        <Comments term={post.data.commentId} />
      </div>

      {tocHeadings.length > 0 && (
        <aside class="toc surface" aria-label="文章目录">
          <div class="toc-inner">
            <p class="toc-title"><Icon name="writing" size={17} />本文目录</p>
            <ol class="toc-list">
              {tocHeadings.map((heading) => (
                <li class:list={["toc-item", `toc-level-${heading.depth}`]}>
                  <a href={`#${heading.slug}`} class="toc-link">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      )}
    </div>

    {otherPosts.length > 0 && (
      <section class="related wrap">
        <h2 class="related-title">再读一篇</h2>
        <ul class="related-list">
          {otherPosts.map((otherPost) => (
            <li class="related-item surface">
              <a href={`/posts/${otherPost.slug}`} class="related-link">
                <p class="related-meta">
                  {otherPost.data.category} · {formatDate(otherPost.data.date)}
                </p>
                <h3 class="related-item-title">{otherPost.data.title}</h3>
                {otherPost.data.description && (
                  <p class="related-desc">{otherPost.data.description}</p>
                )}
                <span class="related-cta">阅读全文 <Icon name="arrow" size={16} /></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-url]');
  const shareStatus = document.querySelector<HTMLElement>('.share-status');

  if (copyButton && shareStatus) {
    copyButton.hidden = false;
    copyButton.addEventListener('click', async () => {
      if (!navigator.clipboard?.writeText) {
        shareStatus.textContent = '浏览器不支持直接复制，请从地址栏复制链接。';
        return;
      }

      copyButton.disabled = true;
      try {
        await navigator.clipboard.writeText(copyButton.dataset.copyUrl || window.location.href);
        shareStatus.textContent = '文章链接已复制。';
      } catch {
        shareStatus.textContent = '复制失败，请从地址栏复制链接。';
      } finally {
        copyButton.disabled = false;
      }
    });
  }
</script>

<style>
  .article { padding: 32px 0 0; }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: calc(var(--reading-width) + var(--card-padding) * 2 + 48px);
    margin: 0 auto;
    padding: 0 24px;
  }
  .article-content-wrap { width: 100%; min-width: 0; padding: var(--card-padding); }
  .article-header { margin-bottom: 32px; padding-bottom: 28px; border-bottom: 1px solid var(--color-rule); }
  .article-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--color-accent-deep); margin-bottom: 16px; }
  .article-title { font-size: clamp(1.6rem, 2.4vw, 2rem); line-height: 1.5; font-weight: 600; margin-bottom: 18px; }
  .article-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 0.8rem; color: var(--color-ink-mute); }
  .meta-sep { color: var(--color-ink-faint); }
  .article-lede { margin-top: 18px; color: var(--color-ink-soft); font-size: 0.98rem; line-height: 1.85; }
  .article-content { font-size: 1rem; line-height: 1.9; }
  .article-content :global(> :first-child) { margin-top: 0; }
  .article-content :global(> :last-child) { margin-bottom: 0; }
  .article-content :global(h2) { font-size: 1.45rem; line-height: 1.5; margin: 36px 0 16px; }
  .article-content :global(h3) { font-size: 1.2rem; line-height: 1.6; margin: 28px 0 12px; }
  .article-content :global(h4) { font-size: 1.05rem; margin: 24px 0 12px; }
  .article-content :global(p) { margin: 18px 0; line-height: 1.9; }
  .article-content :global(ul), .article-content :global(ol) { margin: 16px 0; padding-left: 1.5rem; }
  .article-content :global(li) { margin: 6px 0; line-height: 1.8; }
  .article-content :global(li p) { margin: 6px 0; }
  .article-content :global(blockquote) { margin: 24px 0; padding: 4px 20px; border-left: 3px solid var(--color-accent); border-radius: 0 6px 6px 0; }
  .article-content :global(blockquote p) { font-size: 0.96rem; }
  .article-content :global(pre) { font-size: 0.86rem; line-height: 1.7; }
  .article-content :global(img) { display: block; margin: 24px auto; }
  .article-content :global(a) { color: var(--color-accent-deep); text-decoration: underline; text-decoration-color: #b3d4cd; text-underline-offset: 3px; }
  .article-content :global(a:hover) { text-decoration-color: currentColor; }
  .article-content :global(hr) { margin: 32px 0; }
  .article-content :global(table) { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; margin: 24px 0; font-size: 0.9rem; }
  .article-content :global(th), .article-content :global(td) { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--color-rule); }
  .article-content :global(th) { background: var(--color-bg-offset); font-weight: 600; }
  .article-footer { margin-top: 36px; padding: 22px 0; border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule); }
  .footer-actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  .back-link { display: inline-flex; gap: 8px; align-items: center; color: var(--color-ink-soft); font-size: 0.85rem; }
  .share { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; }
  .share-link { border: 0; border-bottom: 1px solid var(--color-rule); padding: 0 0 2px; font: 0.82rem/1.6 var(--font-sans); color: var(--color-ink-soft); }
  .share-link:hover { border-color: var(--color-accent); color: var(--color-accent-deep); }
  .copy-link { appearance: none; background: none; cursor: pointer; }
  .copy-link:disabled { opacity: 0.6; cursor: wait; }
  .share-status { margin-top: 12px; font-size: 0.8rem; color: var(--color-ink-mute); }
  .share-status:empty { display: none; }
  .toc { display: none; }
  .related { margin: 28px auto 8px; }
  .related-title { font-size: 1.05rem; margin: 0 0 16px; }
  .related-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--layout-gap); }
  .related-item { padding: 24px; margin: 0; transition: box-shadow var(--duration); }
  .related-item:hover { box-shadow: var(--card-shadow-hover); }
  .related-link { display: flex; flex-direction: column; height: 100%; gap: 12px; }
  .related-meta { color: var(--color-ink-mute); font-size: 0.75rem; }
  .related-item-title { font-size: 1.05rem; line-height: 1.6; transition: color var(--duration); }
  .related-link:hover .related-item-title { color: var(--color-accent-deep); }
  .related-desc { color: var(--color-ink-soft); font-size: 0.85rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .related-cta { display: flex; align-items: center; gap: 8px; padding-top: 4px; margin-top: auto; color: var(--color-accent-deep); font-size: 0.8rem; }

  @media (min-width: 1200px) {
    .article-layout.has-toc { max-width: var(--max-width); grid-template-columns: minmax(0, 1fr) var(--sidebar-width); gap: var(--layout-gap); }
    .toc { display: block; position: sticky; top: calc(var(--nav-height) + 24px); align-self: start; max-height: calc(100vh - var(--nav-height) - 48px); overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--color-rule) transparent; }
    .toc-inner { padding: 22px; }
    .toc-title { display: flex; align-items: center; gap: 8px; font-size: 0.88rem; font-weight: 600; margin-bottom: 14px; }
    .toc-list { list-style: none; padding: 0; margin: 0; }
    .toc-item { margin: 0; }
    .toc-link { display: block; padding: 7px 0; color: var(--color-ink-soft); font-size: 0.82rem; line-height: 1.6; }
    .toc-link:hover { color: var(--color-accent-deep); }
    .toc-level-3 .toc-link { padding-left: 14px; font-size: 0.78rem; color: var(--color-ink-mute); }
  }

  @media (max-width: 900px) {
    .related-list { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  }

  @media (max-width: 600px) {
    .article { padding-top: 16px; }
    .article-layout { padding: 0 16px; }
    .article-header { margin-bottom: 24px; padding-bottom: 24px; }
    .article-content { font-size: 0.96rem; }
    .article-title { font-size: 1.6rem; }
    .article-content :global(h2) { font-size: 1.3rem; }
    .footer-actions { align-items: flex-start; flex-direction: column; }
  }
</style>
