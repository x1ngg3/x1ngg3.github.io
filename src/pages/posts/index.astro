---
import ContentLayout from '../../layouts/ContentLayout.astro';
import Icon from '../../components/Icon.astro';
import { getExcerpt } from '../../utils/content';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((first, second) => second.data.date.getTime() - first.data.date.getTime());
const years = [...new Set(allPosts.map(post => post.data.date.getFullYear()))];
const categories = [...new Set(allPosts.map(post => post.data.category))];
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
---

<ContentLayout title="文章归档 · x1ngg3" description="技术、阅读与生活的文字记录">
  <header class="page-head page-heading surface" id="categories">
    <p class="eyebrow"><Icon name="archive" size={17} />文字的存档</p>
    <h1 class="page-title">文章归档</h1>
    <p class="page-lede">把思考写下来。这里一共有 {allPosts.length} 篇文章。</p>
    {categories.length > 0 && (
      <div class="chips" role="group" aria-label="按分类筛选文章" hidden>
        <button type="button" class="chip chip-active" data-category="" aria-pressed="true" aria-controls="posts-archive">全部 <span class="chip-count">{allPosts.length}</span></button>
        {categories.map(category => (
          <button type="button" class="chip" data-category={category} aria-pressed="false" aria-controls="posts-archive">{category} <span class="chip-count">{allPosts.filter(post => post.data.category === category).length}</span></button>
        ))}
      </div>
    )}
    <p class="filter-status" role="status" aria-live="polite" hidden></p>
  </header>

  <div class="archive" id="posts-archive">
    {years.map(year => (
      <section class="year-block">
        <header class="year-head">
          <h2 class="year-label">{year}</h2>
          <span class="year-count">{allPosts.filter(post => post.data.date.getFullYear() === year).length} 篇文章</span>
        </header>
        <ul class="rows">
          {allPosts.filter(post => post.data.date.getFullYear() === year).map(post => (
            <li class="row surface" data-category={post.data.category}>
              <a href={`/posts/${post.slug}`} class="row-link">
                <time class="row-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <div class="row-body">
                  <h3 class="row-title">{post.data.title}</h3>
                  <p class="row-desc">{post.data.description || getExcerpt(post.body)}</p>
                  <span class="row-category">{post.data.category}</span>
                </div>
                <span class="row-arrow"><Icon name="arrow" size={17} /></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {allPosts.length === 0 && <p class="empty surface">还没有文章，过段时间再来看看吧。</p>}
  </div>
</ContentLayout>

<script>
  const filters = document.querySelector<HTMLElement>('.chips');
  const filterStatus = document.querySelector<HTMLElement>('.filter-status');
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.chip');
  const yearBlocks = document.querySelectorAll<HTMLElement>('.year-block');

  if (filters && filterStatus) {
    filters.hidden = false;

    const selectCategory = (requestedCategory: string, updateUrl = false) => {
      const category = Array.from(filterButtons).some(button => button.dataset.category === requestedCategory) ? requestedCategory : '';
      let visibleCount = 0;

      for (const yearBlock of yearBlocks) {
        let yearCount = 0;
        for (const row of yearBlock.querySelectorAll<HTMLElement>('.row')) {
          row.hidden = Boolean(category && row.dataset.category !== category);
          if (!row.hidden) yearCount += 1;
        }
        yearBlock.hidden = yearCount === 0;
        visibleCount += yearCount;
        const countLabel = yearBlock.querySelector<HTMLElement>('.year-count');
        if (countLabel) countLabel.textContent = `${yearCount} 篇文章`;
      }

      for (const button of filterButtons) {
        const active = button.dataset.category === category;
        button.classList.toggle('chip-active', active);
        button.setAttribute('aria-pressed', String(active));
      }

      filterStatus.hidden = false;
      filterStatus.textContent = `${category || '全部'} · ${visibleCount} 篇文章`;

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (category) url.searchParams.set('category', category);
        else url.searchParams.delete('category');
        window.history.replaceState(null, '', url);
      }
    };

    for (const button of filterButtons) {
      button.addEventListener('click', () => selectCategory(button.dataset.category || '', true));
    }

    const syncCategory = () => selectCategory(new URL(window.location.href).searchParams.get('category') || '');
    syncCategory();
    window.addEventListener('popstate', syncCategory);
  }
</script>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--color-rule); border-radius: 6px; background: white; color: var(--color-ink-soft); font-size: 0.8rem; line-height: 1.5; padding: 7px 13px; cursor: pointer; }
  .chip:hover { border-color: var(--color-accent); color: var(--color-accent-deep); }
  .chip-active { background: var(--color-accent); border-color: var(--color-accent); color: white; }
  .chip-active:hover { color: white; }
  .chip-count { opacity: 0.75; font-size: 0.72rem; }
  .filter-status { margin-top: 12px; font-size: 0.75rem; color: var(--color-ink-mute); }
  .archive { display: grid; gap: 24px; margin-top: 26px; }
  .year-head { display: flex; align-items: center; gap: 14px; margin: 0 8px 16px; }
  .year-label { font-size: 1.2rem; }
  .year-count { font-size: 0.78rem; color: var(--color-ink-mute); }
  .rows { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  .row { margin: 0; transition: box-shadow var(--duration); }
  .row:hover { box-shadow: var(--card-shadow-hover); }
  .row-link { display: grid; grid-template-columns: 62px minmax(0, 1fr) 18px; gap: 20px; padding: 26px var(--card-padding); align-items: baseline; }
  .row-date { color: var(--color-ink-mute); font-size: 0.82rem; font-variant-numeric: tabular-nums; }
  .row-title { font-size: 1.05rem; transition: color var(--duration); }
  .row-link:hover .row-title { color: var(--color-accent-deep); }
  .row-desc { font-size: 0.88rem; line-height: 1.8; color: var(--color-ink-mute); margin-top: 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .row-category { display: inline-block; margin-top: 10px; color: var(--color-accent-deep); font-size: 0.72rem; }
  .row-arrow { color: var(--color-accent); align-self: center; }
  .empty { padding: 32px; color: var(--color-ink-mute); }
  @media (max-width: 600px) {
    .row-link { grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 24px; }
    .row-arrow { display: none; }
  }
</style>
