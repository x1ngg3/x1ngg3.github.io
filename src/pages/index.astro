---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import Icon from '../components/Icon.astro';
import { getExcerpt } from '../utils/content';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((first, second) => second.data.date.getTime() - first.data.date.getTime())
  .slice(0, 6);

const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const dockLinks = [
  { href: '#latest', label: '博客', icon: 'writing', tone: 'blue' },
  { href: '/posts', label: '归档', icon: 'archive', tone: 'green' },
  { href: '/thoughts', label: '说说', icon: 'chat', tone: 'violet' },
  { href: '/about', label: '关于', icon: 'coffee', tone: 'amber' },
] as const;
---

<BaseLayout title="x1ngg3 的博客">
  <section slot="cover" class="home-cover" aria-labelledby="site-title">
    <img class="cover-image" src="/images/DJI_20240916081052_0037_D.webp" alt="" width="2560" height="1440" fetchpriority="high" />
    <div class="cover-shade"></div>
    <div class="cover-content">
      <p class="cover-kicker">NOTES ON CODE & LIFE</p>
      <h1 id="site-title" class="cover-title">x1ngg3</h1>
      <p class="cover-subtitle">技术与生活，慢慢写。</p>
      <nav class="cover-dock" aria-label="封面导航">
        {dockLinks.map(item => (
          <a href={item.href}><span class:list={["dock-icon", item.tone]}><Icon name={item.icon} size={25} /></span><span>{item.label}</span></a>
        ))}
        <a href="https://github.com/x1ngg3" target="_blank" rel="noopener noreferrer"><span class="dock-icon slate"><Icon name="github" size={25} /></span><span>GitHub ↗</span></a>
      </nav>
    </div>
    <a href="#latest" class="cover-scroll" aria-label="向下浏览最新文章"><span>往下看看</span><Icon name="down" size={22} /></a>
  </section>

  <div class="home-feed wrap">
    <header class="feed-header" id="latest">
      <div><h2 id="writing-title">最新文章</h2><p>关于技术，也关于日常。</p></div>
      <a href="/posts">全部文章 <Icon name="arrow" size={16} /></a>
    </header>
    <div class="site-grid home-grid">
    <section class="page-main" aria-labelledby="writing-title">
      {recentPosts.length > 0 ? (
        <ul class="post-list">
          {recentPosts.map(post => (
            <li class="post-item">
              <article class="post-card surface">
                <a class="post-link" href={`/posts/${post.slug}`}>
                  <h3 class="post-title">{post.data.title}</h3>
                  <p class="post-description">{post.data.description || getExcerpt(post.body)}</p>
                  <span class="post-cta">阅读全文 <Icon name="arrow" size={16} /></span>
                </a>
                <footer class="post-meta">
                  <div><img class="mini-avatar" src="/images/avatar.webp" alt="" width="24" height="24" loading="lazy" decoding="async" /><span>{post.data.author}</span><span aria-hidden="true">·</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div>
                  <a class="post-category" href={`/posts?category=${encodeURIComponent(post.data.category)}#categories`}>{post.data.category}</a>
                </footer>
              </article>
            </li>
          ))}
        </ul>
      ) : <p class="empty surface">还没有文章，过段时间再来看看吧。</p>}
      <a href="/posts" class="archive-link">查看全部文章 <Icon name="arrow" size={16} /></a>
    </section>
    <BlogSidebar thoughtsFirst />
    </div>
  </div>
</BaseLayout>

<style>
  .home-cover { position: relative; flex-shrink: 0; min-height: 520px; height: 100vh; height: 100dvh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #15353e; }
  .cover-image, .cover-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cover-image { object-fit: cover; object-position: center; border-radius: 0; }
  .cover-shade { background: radial-gradient(ellipse at 50% 42%, rgb(4 15 20 / 28%), transparent 68%), linear-gradient(180deg, rgb(4 15 20 / 8%), rgb(4 15 20 / 8%) 60%, rgb(4 15 20 / 26%)); }
  .cover-content { position: relative; z-index: 1; text-align: center; padding: 24px 20px 72px; }
  .cover-kicker { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.26em; color: rgb(255 255 255 / 88%); margin-bottom: 14px; }
  .cover-title { color: white; font-size: clamp(3.5rem, 5.5vw, 5rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.2; text-shadow: 0 4px 24px rgb(16 48 65 / 12%); }
  .cover-subtitle { color: rgb(255 255 255 / 96%); font-size: 1rem; letter-spacing: 0.2em; margin-top: 18px; text-shadow: 0 2px 8px rgb(16 48 65 / 18%); }
  .cover-dock { display: flex; justify-content: center; margin: 40px auto 0; padding: 8px; gap: 2px; width: fit-content; background: rgb(255 255 255 / 90%); border: 1px solid rgb(255 255 255 / 70%); border-radius: 18px; box-shadow: 0 12px 36px rgb(15 42 60 / 12%); backdrop-filter: blur(16px); }
  .cover-dock a { min-width: 82px; display: flex; align-items: center; flex-direction: column; gap: 9px; padding: 12px 13px 10px; font-size: 0.78rem; font-weight: 500; color: #435563; border-radius: 12px; transition: background var(--duration), transform var(--duration); }
  .cover-dock a:hover { background: white; color: var(--color-accent-deep); transform: translateY(-3px); }
  .dock-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; }
  .blue { background: #e4eef8; color: #426e9a; }
  .green { background: #e0f0e9; color: #3c816b; }
  .violet { background: #eee8f5; color: #8767a1; }
  .amber { background: #f7ebda; color: #9b7139; }
  .slate { background: #e5ebee; color: #4c606e; }
  .cover-scroll { position: absolute; bottom: 52px; left: 50%; transform: translateX(-50%); color: rgb(255 255 255 / 90%); display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 0.72rem; letter-spacing: 0.12em; }
  .cover-scroll:hover { color: white; }
  .home-feed { padding-top: 40px; }
  .home-grid { padding: 0 0 24px; }
  .feed-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; }
  .feed-header h2 { font-size: 1.25rem; font-weight: 600; }
  .feed-header p { margin-top: 4px; font-size: 0.82rem; color: var(--color-ink-mute); }
  .feed-header > a { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--color-ink-mute); white-space: nowrap; }
  .post-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 20px; }
  .post-item { margin: 0; min-width: 0; }
  .post-card { overflow: hidden; transition: box-shadow var(--duration); }
  .post-card:hover { box-shadow: var(--card-shadow-hover); }
  .post-link { display: block; padding: 28px var(--card-padding) 22px; }
  .post-link:focus-visible { outline-offset: -4px; border-radius: var(--radius-md) var(--radius-md) 0 0; }
  .post-title { font-size: 1.35rem; font-weight: 600; line-height: 1.5; transition: color var(--duration); }
  .post-link:hover .post-title { color: var(--color-accent-deep); }
  .post-description { margin-top: 12px; font-size: 0.94rem; line-height: 1.85; color: var(--color-ink-soft); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .post-cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 20px; font-size: 0.82rem; color: var(--color-accent-deep); }
  .post-meta { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; padding: 13px var(--card-padding); border-top: 1px solid var(--color-rule-soft); font-size: 0.75rem; color: var(--color-ink-mute); }
  .post-meta > div { display: flex; align-items: center; flex-wrap: wrap; gap: 9px; }
  .mini-avatar { display: block; flex-shrink: 0; width: 24px; height: 24px; object-fit: cover; border-radius: 50%; background: var(--color-accent-wash); }
  .post-category { color: var(--color-accent-deep); padding: 2px 9px; background: var(--color-accent-wash); border-radius: 5px; }
  .archive-link { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 12px; padding: 20px; font-size: 0.85rem; color: var(--color-ink-mute); }
  .empty { padding: 32px; color: var(--color-ink-mute); }
  @media (max-width: 600px) {
    .cover-content { padding-left: 12px; padding-right: 12px; }
    .cover-kicker { font-size: 0.55rem; letter-spacing: 0.2em; }
    .cover-dock { padding: 5px; gap: 0; }
    .cover-dock a { min-width: 57px; padding: 10px 9px; font-size: 0.72rem; }
    .dock-icon { width: 38px; height: 38px; border-radius: 11px; }
    .home-feed { padding-top: 28px; }
    .post-title { font-size: 1.25rem; }
  }

  @media (max-height: 640px) and (min-width: 901px) {
    .home-cover { min-height: 440px; }
    .cover-content { padding-bottom: 48px; }
    .cover-title { font-size: 3.5rem; }
    .cover-dock { margin-top: 24px; }
    .cover-scroll { bottom: 40px; }
  }
</style>
