---
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const currentPath = Astro.url.pathname;

const formatDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', {
    year: '2-digit',
    month: '2-digit',
    day: '2-digit',
  }).replace(/\//g, '.');
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <header class="sidebar-head">
      <p class="sidebar-eyebrow">Index</p>
      <h3 class="sidebar-title">所有文章</h3>
      <span class="sidebar-count">{allPosts.length} 篇</span>
    </header>

    <nav aria-label="文章列表">
      <ol class="post-list">
        {allPosts.map((post) => {
          const isActive = currentPath.includes(post.slug);
          return (
            <li class="post-list-item">
              <a
                href={`/posts/${post.slug}`}
                class:list={["post-link", { 'is-active': isActive }]}
              >
                <time class="post-link-date">
                  {formatDate(post.data.date)}
                </time>
                <span class="post-link-title">{post.data.title}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    left: 0;
    top: 5.5rem;
    width: 280px;
    height: calc(100vh - 5.5rem);
    overflow-y: auto;
    background: transparent;
  }

  .sidebar-inner {
    padding: 2rem 1.5rem 2rem max(1.5rem, calc((100vw - 1440px) / 2 + 1.5rem));
  }

  /* —— 标题 —— */
  .sidebar-head {
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-rule-soft);
  }

  .sidebar-eyebrow {
    color: var(--color-ink-faint);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }

  .sidebar-title {
    display: inline;
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.005em;
  }

  .sidebar-count {
    margin-left: 0.5ch;
    color: var(--color-ink-faint);
    font-size: 0.78rem;
    font-weight: 400;
  }

  /* —— 文章列表 —— */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list-item {
    margin: 0;
  }

  .post-link {
    display: block;
    padding: 0.55rem 0.6rem;
    margin: 0 -0.6rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    border-bottom: none;
    transition: background var(--duration) var(--ease);
  }

  .post-link:hover {
    background: var(--color-paper-deep);
  }

  .post-link.is-active {
    background: var(--color-paper-deep);
  }

  .post-link-date {
    display: block;
    color: var(--color-ink-faint);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    margin-bottom: 0.2rem;
  }

  .post-link-title {
    display: block;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--color-ink-soft);
    font-weight: 400;
    transition: color var(--duration) var(--ease);
  }

  .post-link:hover .post-link-title {
    color: var(--color-ink);
  }

  .post-link.is-active .post-link-title {
    color: var(--color-accent);
    font-weight: 500;
  }

  /* —— 滚动条 —— */
  .sidebar::-webkit-scrollbar {
    width: 6px;
  }

  .sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 3px;
  }

  .sidebar:hover::-webkit-scrollbar-thumb {
    background: var(--color-rule);
  }

  .sidebar {
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
  }

  .sidebar:hover {
    scrollbar-color: var(--color-rule) transparent;
  }

  @media (max-width: 1200px) {
    .sidebar {
      display: none;
    }
  }
</style>
