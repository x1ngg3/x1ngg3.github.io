---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { getExcerpt } from '../utils/content';

interface Props {
  thoughtsFirst?: boolean;
}

const { thoughtsFirst = false } = Astro.props;
const sections = thoughtsFirst ? ['thoughts', 'profile', 'categories'] : ['profile', 'categories', 'thoughts'];

const posts = (await getCollection('posts')).filter(post => !post.data.draft);
const thoughts = (await getCollection('thoughts'))
  .sort((first, second) => second.data.date.getTime() - first.data.date.getTime());
const categories = [...new Set(posts.map(post => post.data.category))];
const recentThoughts = thoughts.slice(0, 3).map(thought => ({
  thought,
  title: thought.body.match(/^#{1,6}\s+(.+)$/m)?.[1] || '日常一记',
  excerpt: getExcerpt(thought.body, 80),
}));
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
---

<aside class="blog-sidebar" aria-label="博客侧栏">
  {sections.map(section => (
    <>
      {section === 'profile' && (
        <section class="profile-card surface">
          <div class="profile-banner" aria-hidden="true"></div>
          <a href="/about" class="profile-avatar" aria-label="了解 x1ngg3"><img class="profile-avatar-image" src="/images/avatar.webp" alt="" width="68" height="68" loading="lazy" decoding="async" /></a>
          <h2 class="profile-name">x1ngg3</h2>
          <p class="profile-description">IoT 安全 / 工程 / 生活<br/>写下所想，慢慢生长。</p>
          <div class="profile-stats">
            <a href="/posts"><strong>{posts.length}</strong><span>文章</span></a>
            <a href="/thoughts"><strong>{thoughts.length}</strong><span>说说</span></a>
            <a href="/posts#categories"><strong>{categories.length}</strong><span>分类</span></a>
          </div>
          <a class="profile-github" href="https://github.com/x1ngg3" target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} />GitHub ↗</a>
        </section>
      )}

      {section === 'categories' && categories.length > 0 && (
        <section class="widget surface">
          <h2 class="widget-title"><span class="widget-icon"><Icon name="folder" size={17} /></span>文章分类</h2>
          <ul class="category-list">
            {categories.map(category => (
              <li><a href={`/posts?category=${encodeURIComponent(category)}#categories`}>
                <span>{category}</span><span class="category-count">{posts.filter(post => post.data.category === category).length}</span>
              </a></li>
            ))}
          </ul>
        </section>
      )}

      {section === 'thoughts' && recentThoughts.length > 0 && (
        <section class="widget surface">
          <h2 class="widget-title"><span class="widget-icon"><Icon name="chat" size={17} /></span>最近说说<a href="/thoughts" class="widget-more">全部 →</a></h2>
          <ul class="note-list">
            {recentThoughts.map(({ thought, title, excerpt }) => (
              <li class="note">
                <time class="note-time" datetime={thought.data.date.toISOString()}>{formatDate(thought.data.date)}</time>
                <div class="note-preview">
                  <h3><a class="note-link" href={`/thoughts#note-${thought.slug}`}>{title}</a></h3>
                  <p>{excerpt}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  ))}
</aside>

<style>
  .blog-sidebar { display: grid; gap: 20px; min-width: 0; }
  .profile-card { overflow: hidden; text-align: center; padding-bottom: 20px; }
  .profile-banner { height: 92px; background: #15353e url('/images/DJI_20240916081052_0037_D-thumb.webp') center 45% / cover; }
  .profile-avatar { position: relative; display: block; width: 68px; height: 68px; margin: -34px auto 10px; overflow: hidden; border: 4px solid white; border-radius: 50%; background: var(--color-accent-wash); }
  .profile-avatar-image { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .profile-name { font-size: 1.1rem; margin-bottom: 7px; }
  .profile-description { font-size: 0.8rem; line-height: 1.85; color: var(--color-ink-mute); }
  .profile-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 20px 16px 16px; }
  .profile-stats a { display: flex; flex-direction: column; align-items: center; border-right: 1px solid var(--color-rule); }
  .profile-stats a:last-child { border-right: 0; }
  .profile-stats strong { font-size: 1.1rem; color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .profile-stats span { font-size: 0.75rem; color: var(--color-ink-mute); }
  .profile-github { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0 22px; border-radius: 7px; padding: 8px; color: var(--color-accent-deep); background: var(--color-accent-wash); font-size: 0.8rem; }
  .profile-github:hover { background: #e0eeea; }
  .widget { padding: 20px 22px; }
  .widget-title { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; margin-bottom: 12px; }
  .widget-icon { color: var(--color-accent); }
  .widget-more { margin-left: auto; font-size: 0.72rem; font-weight: 400; color: var(--color-ink-mute); }
  .category-list, .note-list { list-style: none; padding: 0; margin: 0; }
  .category-list li { margin: 0; }
  .category-list a { display: flex; justify-content: space-between; align-items: center; padding: 8px 9px; margin: 0 -9px; border-radius: 6px; font-size: 0.82rem; }
  .category-list a:hover { background: var(--color-accent-wash); }
  .category-count { display: grid; place-items: center; min-width: 22px; height: 22px; border-radius: 5px; background: var(--color-bg); color: var(--color-ink-mute); font-size: 0.72rem; }
  .note { padding: 12px 0; margin: 0; border-top: 1px solid var(--color-rule-soft); }
  .note:last-child { padding-bottom: 0; }
  .note-time { color: var(--color-ink-mute); font-size: 0.72rem; font-variant-numeric: tabular-nums; }
  .note-preview h3 { font-size: 0.86rem; font-weight: 500; margin: 5px 0; line-height: 1.65; }
  .note-preview p { font-size: 0.8rem; line-height: 1.75; margin: 5px 0 0; color: var(--color-ink-mute); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .note-link { color: var(--color-ink-soft); }
  .note-link:hover { color: var(--color-accent-deep); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) { .blog-sidebar { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; } }
  @media (max-width: 600px) { .blog-sidebar { grid-template-columns: minmax(0, 1fr); } }
</style>
